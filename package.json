{
  "scripts": {
    "install-all": "yarn install && cd client && yarn install && cd ../server && yarn install",
    "client": "cd client && yarn run dev",
    "server": "cd server && yarn run dev",
    "client:start": "cd client && yarn start",
    "server:start": "cd server && yarn start",
    "build": "cd client && yarn run build",
    "dev": "concurrently \"yarn run client\" \"yarn run server\"",
    "start": "concurrently \"yarn run client:start\" \"yarn run server:start\"",
    "migrate:up": "cd server && npm run migrate:up",
    "migrate:down": "cd server && npm run migrate:down",
    "migrate:status": "cd server && npm run migrate:status",
    "db:migrate-new": "cd server && npm run db:migrate-new",
    "db:migrate-appusers": "cd server && npm run db:migrate-appusers",
    "restore:backup": "cd server && npm run restore:backup"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {}
}
